# ===================================
# NatooKart Backend Configuration
# ===================================

# Environment: 'development' or 'production'
NODE_ENV=development

# ── MySQL Database ──────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=thilak@374
DB_NAME=grocery_platform

# ── Server ──────────────────────────
PORT=4000

# ── Frontend URL (for CORS + emails) ──
FRONTEND_URL=http://localhost:3000,http://localhost:3001
PUBLIC_SITE_URL=http://localhost:3000

# ── Auth ────────────────────────────
JWT_SECRET=natookart_secret_key_2026

# ──────────────────────────────────────────────────
# EMAIL (Nodemailer / Gmail SMTP)
# How to get an App Password:
#   Google Account → Security → 2-Step Verification → App passwords
# ──────────────────────────────────────────────────
SMTP_USER=support@devasthra.com
SMTP_APP_PASSWORD=pxxq fzom tboj ftmd
SMTP_FROM_NAME=NatooKart

# Admin / support inbox that receives all admin notifications
SUPPORT_EMAIL=admin@natookart.com

# ──────────────────────────────────────────────────
# SMS (2Factor.in transactional SMS)
# Sign up at https://2factor.in, get API key from dashboard.
# Create a sender ID (e.g. NATOKT) and a DLT-approved template.
# ──────────────────────────────────────────────────
TWO_FACTOR_API_KEY=c67db5a0-0264-11f1-a6b2-0200cd936042

# Sender IDs per purpose (all fall back to TWO_FACTOR_SENDER_ID)
TWO_FACTOR_SENDER_ID=NATOKT

# Shared template name for all transactional SMS
TWO_FACTOR_TEMPLATE_NAME=Natookart2
